{
  "openapi": "3.0.3",
  "info": {
    "title": "RocketRide - Meta harness",
    "version": "0.2",
    "description": "HTTP and MCP endpoints of the RocketRide meta-harness running as an Apify Server Actor. Authenticate every request with `Authorization: Bearer <APIFY_TOKEN>`."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "apifyToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your Apify API token"
      }
    },
    "schemas": {
      "PipelineInput": {
        "type": "object",
        "description": "Send inline text or a URL to fetch, plus the pipeline's options. You can also POST raw file bytes or multipart/form-data and pass options in the query string. The agent pipeline takes only a question.",
        "properties": {
          "text": {
            "type": "string",
            "example": "Invoice INV-2026-0042 from Acme Robotics. Total due: 960.00 USD by 2026-12-01."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://arxiv.org/pdf/1706.03762"
          },
          "filename": {
            "type": "string",
            "example": "invoice.pdf"
          },
          "question": {
            "type": "string",
            "description": "ask, agent: required",
            "example": "What is the total due?"
          },
          "fields": {
            "type": "array",
            "description": "extract-data: required. Column names or {name, type, default} objects",
            "items": {},
            "example": [
              "invoice_number",
              "total"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic",
              "gemini",
              "openai-compatible"
            ],
            "description": "LLM pipelines. Default: the first configured provider"
          },
          "model": {
            "type": "string",
            "description": "LLM pipelines. Model id at the provider",
            "example": "gpt-4o-mini"
          },
          "ocr": {
            "type": "boolean",
            "description": "summarize, extract-data, ask: OCR scanned pages and images"
          },
          "summaryWords": {
            "type": "integer",
            "description": "summarize: target length (default 250)"
          },
          "keyPoints": {
            "type": "boolean",
            "description": "summarize: include key points (default true)"
          },
          "entities": {
            "type": "integer",
            "description": "summarize: entities to list (default 15)"
          },
          "chunks": {
            "type": "integer",
            "description": "summarize: chunks of a long document to cover (default 3)"
          },
          "instructions": {
            "type": "string",
            "description": "agent: system instructions"
          },
          "web": {
            "type": "boolean",
            "description": "agent: allow the HTTP request tool (default true)"
          },
          "maxSteps": {
            "type": "integer",
            "description": "agent: max plan/act rounds (default 6)"
          }
        }
      },
      "PipelineResult": {
        "type": "object",
        "properties": {
          "pipeline": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer"
          },
          "text": {
            "type": "string",
            "description": "doc-to-text, redact-pii, summarize: text output"
          },
          "answer": {
            "type": "string",
            "description": "ask, agent: the answer"
          },
          "data": {
            "description": "extract-data: rows of extracted fields",
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "result": {
            "type": "object",
            "description": "Raw engine result"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "apifyToken": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Server info and endpoint list",
        "responses": {
          "200": {
            "description": "Server info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Engine health",
        "responses": {
          "200": {
            "description": "Engine is up"
          },
          "503": {
            "description": "Engine is starting or down"
          }
        }
      }
    },
    "/pipelines": {
      "get": {
        "summary": "List ready-made pipelines, their options and configured LLM providers",
        "responses": {
          "200": {
            "description": "Pipeline catalog"
          }
        }
      }
    },
    "/pipelines/{name}": {
      "get": {
        "summary": "Get the .pipe definition a request would run",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "doc-to-text",
                "redact-pii",
                "summarize",
                "extract-data",
                "ask",
                "agent"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pipeline description and definition"
          },
          "404": {
            "description": "Unknown pipeline"
          }
        }
      },
      "post": {
        "summary": "Run a ready-made pipeline",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "doc-to-text",
                "redact-pii",
                "summarize",
                "extract-data",
                "ask",
                "agent"
              ]
            }
          },
          {
            "name": "filename",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "File name hint for raw uploads"
          },
          {
            "name": "save",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Also append the result to the run's dataset"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineInput"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pipeline output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Engine, node or LLM error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/run": {
      "post": {
        "summary": "Run any webhook-source RocketRide pipeline once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "pipeline"
                ],
                "properties": {
                  "pipeline": {
                    "type": "object",
                    "description": "Contents of a .pipe file with a webhook source"
                  },
                  "text": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "filename": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pipeline output"
          },
          "400": {
            "description": "Bad input"
          },
          "502": {
            "description": "Engine error"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "RocketRide MCP server (Streamable HTTP)",
        "description": "Point any MCP client here. Tools let agents create, validate, run and trace pipelines. See https://docs.rocketride.org/connect/mcp/http/tools",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response or event stream"
          }
        }
      }
    },
    "/engine/{path}": {
      "get": {
        "summary": "Pass-through to the engine HTTP API (e.g. /engine/version, /engine/services)",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Engine response"
          }
        }
      },
      "post": {
        "summary": "Pass-through to the engine HTTP API (e.g. /engine/task, /engine/webhook, /engine/pipe/validate)",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Engine response"
          }
        }
      }
    }
  }
}
