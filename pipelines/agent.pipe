    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "config": {
        "instructions": [
          "You are a helpful research assistant. Use the HTTP request tool to fetch web pages or APIs when you need current or specific information. Answer clearly and say which URLs you used."
